PORT=5000
NODE_ENV=development

# JWT Access & Refresh Token Secrets
JWT_SECRET=rescuenex_super_secure_jwt_access_secret_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=rescuenex_super_secure_jwt_refresh_secret_2026
JWT_REFRESH_EXPIRES_IN=7d

# MongoDB Atlas Connection String
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/rescuenex?retryWrites=true&w=majority
MONGODB_URI=
AI_ENGINE_URL=http://localhost:8000

# Weather polling interval (minutes)
WEATHER_POLL_INTERVAL_MINS=15

# Resend Email API Key (for sending verification OTPs during signup)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google OAuth 2.0 Client ID (Optional for Google Sign-In)
GOOGLE_CLIENT_ID=
