    {
      "name": "02. Authentication & Sessions",
      "item": [
        {
          "name": "POST Admin Login (Priyanshu Gupta)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "  pm.collectionVariables.set('adminAccessToken', res.accessToken);",
                  "  pm.test('Status code is 200 and token received', () => {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    pm.expect(res.accessToken).to.be.a('string');",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"lead@rescuenex\",\n  \"password\": \"gupta18\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
